{
  "name": "vistavka",
  "version": "1.0.0",
  "description": "Offline-ready kiosk website template with SCSS and Swiper",
  "main": "index.html",
  "scripts": {
    "build:css": "sass src/scss/style.scss assets/css/style.css --no-source-map",
    "watch:css": "sass --watch src/scss/style.scss:assets/css/style.css",
    "serve": "node scripts/serve.js",
    "dev": "concurrently \"npm:watch:css\" \"npm:serve\"",
    "build": "npm run build:css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "sass": "^1.97.3"
  },
  "dependencies": {
    "swiper": "^12.1.2"
  }
}
